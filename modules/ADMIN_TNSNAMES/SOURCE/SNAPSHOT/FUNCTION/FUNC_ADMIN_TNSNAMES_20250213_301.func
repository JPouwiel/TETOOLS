HOST          '^\s*[(]?\w+(\d{1})?(\s)*=(\s)*((\w+([.-]*\w+)*)*|([1-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.(([0-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){2}([1-9]{1}|[0-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))?(\s)*([)])?(\s)?$'
HOST          '^\s*[(]?\w+(\d{1})?(\s)*=(\s)*((\w+([.-]*\w+)*)*|([1-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.(([0-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){2}([1-9]{1}|[0-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))?(\s)*([)])?(\s)?$'
