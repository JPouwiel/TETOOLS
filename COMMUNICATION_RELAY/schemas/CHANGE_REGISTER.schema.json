{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHANGE_REGISTER schema_version 1 (existing contract)",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "PLSQL_TETOOLS"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "record_type",
          "subject",
          "status",
          "source_reference",
          "origin_session",
          "recorded_by_session",
          "recorded_at"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "origin_session": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "recorded_by_session": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "project": {
            "const": "PLSQL_TETOOLS"
          },
          "status": {
            "enum": [
              "PROPOSED",
              "APPROVED",
              "REJECTED",
              "SUPERSEDED",
              "CLOSED",
              "IMPLEMENTED"
            ]
          },
          "handoff_assessment": {
            "type": "object",
            "required": [
              "capacity",
              "readiness"
            ],
            "properties": {
              "capacity": {
                "type": "object",
                "required": [
                  "meaning",
                  "rationale",
                  "assessed_by",
                  "assessed_at",
                  "evidence_kind",
                  "evidence_refs",
                  "state"
                ],
                "properties": {
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "assessed_by": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "assessed_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "evidence_kind": {
                    "enum": [
                      "PLATFORMMELDING",
                      "METING",
                      "GEBRUIKERSMELDING",
                      "HEURISTIEK",
                      "ONBEKEND"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "state": {
                    "enum": [
                      "ONBEKEND",
                      "AANDACHT",
                      "OVERDRACHT_AANBEVOLEN",
                      "LIMIET_BEREIKT"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "readiness": {
                "type": "object",
                "required": [
                  "meaning",
                  "rationale",
                  "assessed_by",
                  "assessed_at",
                  "evidence_kind",
                  "evidence_refs",
                  "state",
                  "package_ref",
                  "publication",
                  "receipt",
                  "transfer"
                ],
                "properties": {
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "assessed_by": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "assessed_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "evidence_kind": {
                    "enum": [
                      "PLATFORMMELDING",
                      "METING",
                      "GEBRUIKERSMELDING",
                      "HEURISTIEK",
                      "ONBEKEND"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "state": {
                    "enum": [
                      "ONVOLLEDIG",
                      "VOORBEREID",
                      "GEPUBLICEERD",
                      "OVERGENOMEN"
                    ]
                  },
                  "package_ref": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    ]
                  },
                  "publication": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "commit",
                          "pr_head",
                          "evidence_ref"
                        ],
                        "properties": {
                          "commit": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                          },
                          "pr_head": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                          },
                          "evidence_ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "receipt": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "session_id",
                          "received_at",
                          "evidence_ref",
                          "independent_source_check"
                        ],
                        "properties": {
                          "session_id": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "received_at": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "evidence_ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "independent_source_check": {
                            "const": true
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "transfer": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "from_session",
                          "to_session",
                          "effective_at",
                          "designation_ref",
                          "predecessor_available"
                        ],
                        "properties": {
                          "from_session": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "to_session": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "effective_at": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "designation_ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "predecessor_available": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "handoff_assessment"
              ]
            },
            "then": {
              "properties": {
                "record_type": {
                  "const": "HANDOVER"
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "description": "Legacy records may inherit project from registry root; no historical entries rewritten. Cross-record and lifecycle rules remain in validators."
}
