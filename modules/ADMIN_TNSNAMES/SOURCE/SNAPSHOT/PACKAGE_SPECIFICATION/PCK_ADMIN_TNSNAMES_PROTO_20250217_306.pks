CREATE OR REPLACE PACKAGE admin_tnsnames_proto AUTHID DEFINER
IS
  --B-  /* ======================================================================================================= */
  --B-  --
  --B-  -- BANNER FOR PACKAGE TETOOLS.ADMIN_TNSNAMES
  --B-  --
  --B-  /* ------------------------------------------------------------------------------------------------------- */
  --B-
  --B-    Package name:  ADMIN_TNSNAMES_PROTO
  --B-     Author:       TET
  --B-     Version:      0.1
  --B-     Purpose:      This package allows users to add a TNSNAMES registration.
  --B-     Parameters:   Depends on procedure being called. Execute TETOOLS.ADMIN_TNSNAMESPROTO.help for usage examples.
  --B-
  --B-    History
  --B-    Version  Date       Changed by     Remark
  --B-    -------- ---------- -------------- ------------------------------------
  --B-         0.1 2025-02-25     [AUTHOR REDACTED] Setup package
  --B-
  --B-  /* ======================================================================================================= */
  --
  --HS-  /* ======================================================================================================= */
  --HS-  --
  --HS-  -- HELP / USAGE SCENARIOS FOR PACKAGE TETOOLS.ADMIN_TNSNAMES_PROTO
  --HS-  --
  --HS-  /* ------------------------------------------------------------------------------------------------------- */
  --HS-
  --HS-   DISPLAY THIS HELP SECTION
  --HS-   ---------------------------------------------------------------------------------
  --HS-   exec TETOOLS.ADMIN_TNSNAMES_PROTO.help[(p_verbose => 'N/Y')]; --DEFAULT = NO
  --HV-
  --HV-   DESCRIPTION OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.help
  --HV-   ---------------------------------------------------------------------------------
  --HV-   The [help] procedure will display usage scenarios and examples of the procedures contained within the
  --HV-   [ADMIN_TNSNAMES] package which are made public via the header.
  --HV-
  --HV-   ACCEPTED PARAMETERS FOR:  TETOOLS.ADMIN_TNSNAMES_PROTO.help
  --HV-   ---------------------------------------------------------------------------------
  --HV-   p_verbose: 'Y'
  --HV-   p_verbose: 'N' -- Default.
  --HV-
  --HV-   --  The [help] procedure takes one (1) parameter < p_verbose >. Using this parameter, the user may choose whether
  --HV-       to display the extended help/usage information contained in the specification of the header.
  --HV-
  --HV-   (SAMPLE) OUTPUT OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.help
  --HV-   ---------------------------------------------------------------------------------
  --HV-
  --HV-       --HS-   DISPLAY THIS HELP SECTION
  --HV-       --HS-   ---------------------------------------------------------------------------------
  --HV-       --HS-   exec TETOOLS.ADMIN_TNSNAMES_PROTO.help[(p_verbose => 'N/Y')]; --DEFAULT = No
  --HV-       --HS-
  --HV-       --HV-   DESCRIPTION OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.help
  --HV-       --HV-   ---------------------------------------------------------------------------------
  --HV-       --HV-   The [help] procedure will display usage scenarios and examples of the procedures contained within the
  --HV-       --HV-   [ADMIN_TNSNAMES_PROTO] package which are made public via the header.
  --HV-       --HV-   The [help] procedure takes one (1) parameter < p_verbose >. Using this parameter, the user may choose whether
  --HV-       --HV-   to display the extended help/usage information contained in the specification of the header.
  --HV-
  --HS-
  --HS-   REGISTER A TNS ALIAS
  --HS-   -----------------------------------------------------------------------
  --HS-   EXEC TETOOLS.ADMIN_TNSNAMES_PROTO.register_tns ( p_crud           ,
  --HS-                                              p_tns_id         ,
  --HS-                                              p_tns_alias      ,
  --HS-                                              p_target_phase   ,
  --HS-                                              p_target_envs    ,
  --HS-                                              p_host_name      ,
  --HS-                                              p_service_name   ,
  --HS-                                              p_port           ,
  --HS-                                              p_date_valid_from,
  --HS-                                              p_description    ,
  --HS-                                              p_date_valid_end ,
  --HS-                                              p_connect_timeout,
  --HS-                                              p_retry_delay    ,
  --HS-                                              p_retry_count    ,
  --HS-                                              p_failover       ,
  --HS-                                              p_load_balance   ,
  --HS-                                              p_force          );
  --HS-
  --HV-
  --HV-   DESCRIPTION OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.register_tns
  --HV-   ---------------------------------------------------------------------------------
  --HV-   The [register_tns] procedure will insert, update, or delete the (if exists)
  --HV-   the corresponding record for the given tns_alias details.
  --HV-
  --HV-   ACCEPTED PARAMETERS FOR:  TETOOLS.ADMIN_TNSNAMES_PROTO.register_tns
  --HV-   ---------------------------------------------------------------------------------
  --HV-   p_crud            IN CHAR
  --HV-   p_tns_id          IN INTEGER
  --HV-   p_tns_alias       IN VARCHAR2
  --HV-   p_target_phase    IN CHAR
  --HV-   p_target_envs     IN VARCHAR2
  --HV-   p_host_name       IN VARCHAR2
  --HV-   p_service_name    IN VARCHAR2
  --HV-   p_port            IN NUMBER
  --HV-   p_date_valid_from IN VARCHAR2   DEFAULT SYSDATE
  --HV-   p_description     IN VARCHAR2   DEFAULT NULL
  --HV-   p_date_valid_end  IN VARCHAR2   DEFAULT '9999-12-31'
  --HV-   p_connect_timeout IN NUMBER     DEFAULT NULL
  --HV-   p_retry_delay     IN NUMBER     DEFAULT NULL
  --HV-   p_retry_count     IN NUMBER     DEFAULT NULL
  --HV-   p_failover        IN VARCHAR2   DEFAULT NULL
  --HV-   p_load_balance    IN VARCHAR2   DEFAULT NULL
  --HV-   p_force           IN CHAR       DEFAULT 'N'
  --HV-
  --HV-   --  The [register_tns] procedure takes seventeen (17) parameters.
  --HV-       Not all of these parameters need to be given, as some have default values.
  --HV-
  --HV-   (SAMPLE) OUTPUT OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.register_tns
  --HV-   ---------------------------------------------------------------------------------
  --HV-     OUTPUT AS ADMIN/DBA USER
  --HV-     ---------------------------------------------------------------------------------
  --HV-     DECLARE                                            
  --HV-       l_clob  CLOB;                                    
  --HV-     BEGIN                                              
  --HV-     	SELECT TO_CLOB(q'[                               
  --HV-       # test description for parsing existing tns entry
  --HV-       foo_baz_20250217__0002 =                         
  --HV-         (DESCRIPTION_LIST =                            
  --HV-           (DESCRIPTION =                               
  --HV-           (TRANSPORT_CONNECT_TIMEOUT = 5)              
  --HV-           (CONNECT_TIMEOUT = 5)                        
  --HV-           (RETRY_DELAY = 1)                            
  --HV-           (RETRY_COUNT = BLAAT)                        
  --HV-           (FAILOVER = ON)                              
  --HV-           (LOAD_BALANCE = OFF)                         
  --HV-             (ADDRESS_LIST =                            
  --HV-               (ADDRESS_1 =                             
  --HV-                 (PROTOCOL_1 = TCP)                     
  --HV-                 (HOST_1 = 192.0.2.10)                  
  --HV-                 (PORT_1 = 1521)                        
  --HV-               )                                        
  --HV-               (ADDRESS_2 =                             
  --HV-                 (PROTOCOL_2 = TCP)                     
  --HV-                 (HOST_2 = 192.0.2.10)                  
  --HV-                 (PORT_2 = 1526)                        
  --HV-               )                                        
  --HV-               (ADDRESS_3 =                             
  --HV-                 (PROTOCOL_3 = TCP)                     
  --HV-                 (HOST_3 = example.invalid)           
  --HV-                 (PORT_3 = 1522)                        
  --HV-               )                                        
  --HV-             )                                          
  --HV-             (CONNECT_DATA =                            
  --HV-               (SERVICE_NAME = foo_baz_20250217__0002)  
  --HV-               (SERVER = VIES)                          
  --HV-             )                                          
  --HV-           )                                            
  --HV-         )                                              
  --HV-       (DATE_VALID_FROM = sysdate,)                     
  --HV-       (DATE_VALID_TILL = 9999-12-31,)                  
  --HV-       (PHASE = T)                                      
  --HV-      TARGET_ENV = TST]') INTO l_clob FROM DUAL;       
  --HV-      --                                               
  --HV-      admin_tnsnames_proto.intake_entry(l_clob);       
  --HV-    END;                                               
  --HV-    /                                                  
  --HV-
  --HV-
  --HV-
  --HV-
  --HV-
  --HV-                  .#@@@%**%@+
  --HV-               :%@@=.  =.   .=    TET - TNSNAMES ADMINISTRATION PACKAGE 0.301
  --HV-             :@@%: .=#%@@@=  .
  --HV-            #@@= =@@@@%@@%=.
  --HV-          .@@@::@@@=  =:          PROTO TNS Registration : 2787 (17-FEB-25 03:51:36 PM)
  --HV-          *@@%.@@# :.:::.:= -     USER                   : TETOOLS
  --HV-          @@@#=@@: +:-*#**:#:
  --HV-          *@@@=%@
  --HV-           =@@@@@@@@#:
  --HV-
  --HV-          -- REPORT:  STATUS OF PROTO_REGISTRATION -------------------------------------------------------------------------------------------------------------
  --HV-
  --HV-         # PROTO_TNS_ID : 2787
  --HV-          ENTRY_DESCRIPTION                 = # test description for parsing existing tns entry
  --HV-          TARGET_ENV                        = TST
  --HV-          PHASE                             = T
  --HV-          DATE_VALID_TILL                   = 9999-12-31
  --HV-          DATE_VALID_FROM                   = sysdate
  --HV-          SERVER                            = VIES
  --HV-          SERVICE_NAME                      = foo_baz_20250217__0002
  --HV-          CONNECT_DATA                      = NULL
  --HV-          PORT_3                            = 1522
  --HV-          HOST_3                            = example.invalid
  --HV-          PROTOCOL_3                        = TCP
  --HV-          ADDRESS_3                         = NULL
  --HV-          PORT_2                            = 1526
  --HV-          HOST_2                            = 192.0.2.10
  --HV-          PROTOCOL_2                        = TCP
  --HV-          ADDRESS_2                         = NULL
  --HV-          PORT_1                            = 1521
  --HV-          HOST_1                            = 192.0.2.10
  --HV-          PROTOCOL_1                        = TCP
  --HV-          ADDRESS_1                         = NULL
  --HV-          ADDRESS_LIST                      = NULL
  --HV-          LOAD_BALANCE                      = OFF
  --HV-          FAILOVER                          = ON
  --HV-          RETRY_COUNT                       = BLAAT
  --HV-          RETRY_DELAY                       = 1
  --HV-          CONNECT_TIMEOUT                   = 5
  --HV-          TRANSPORT_CONNECT_TIMEOUT         = 5
  --HV-          DESCRIPTION                       = NULL
  --HV-          DESCRIPTION_LIST                  = NULL
  --HV-
  --HV-                                                               Don't forget to execute TETOOLS.ADMIN_TNSNAMES.REGISTER_TNS !
  --HS-
  --HS-
  --HS-   GENERATE A TNS REGISTRATION TEMPLATE
  --HS-   ---------------------------------------------------------------------------------
  --HS-   EXEC TETOOLS.ADMIN_TNSNAMES_PROTO.generate_template ( p_type          ,
  --HS-                                                         p_num_hosts     );
  --HS-
  --HV-
  --HV-   DESCRIPTION OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.generate_template
  --HV-   ---------------------------------------------------------------------------------
  --HV-   The [generate_template] procedure will generate a valid JSON template
  --HV-   where the required parameters for registering a tns alias are given.
  --HV-   The given placeholders can/must be replaced with the correct parameters.
  --HV-
  --HV-   ACCEPTED PARAMETERS FOR:  TETOOLS.ADMIN_TNSNAMES_PROTO.generate_template
  --HV-   ---------------------------------------------------------------------------------
  --HV-   p_type            IN VARCHAR2(8)   : 'SIMPLE'     -- DEFAULT
  --HV-   p_type            IN VARCHAR2(8)   : 'ADVANCED'
  --HV-   p_num_hosts       IN INTEGER       : MAX(3)       -- DEFAULT 1
  --HV-
  --HV-   --  The [generate_template] procedure takes two (2) parameters.
  --HV-       Not all of these parameters need to be given, as some have default values.
  --HV-       When choosing a 'SIMPLE' template, the number of hosts is limited to one (1).
  --HV-
  --HV-   (SAMPLE) OUTPUT OF:  TETOOLS.ADMIN_TNSNAMES_PROTO.generate_template
  --HV-   ---------------------------------------------------------------------------------
  --HV-     OUTPUT AS ADMIN/DBA USER
  --HV-     ---------------------------------------------------------------------------------
  --HV-     DECLARE
  --HV-       v_type                   VARCHAR2(8)         := 'SIMPLE';
  --HV-       v_num_hosts              INTEGER             := 1;
  --HV-     BEGIN
  --HV-       tetools.admin_tnsnames_proto.generate_template(v_type, v_num_hosts);
  --HV-       --
  --HV-     END;
  --HV-     /
  --HV-
