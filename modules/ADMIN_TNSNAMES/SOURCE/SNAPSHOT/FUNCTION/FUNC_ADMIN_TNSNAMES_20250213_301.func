create or replace type tetools.tns_type_attr_valdn 
as object
( admin_tnsnames_tns_id    INTEGER,
  admin_tnsnames_tns_match VARCHAR2(13)
);
/

CREATE OR REPLACE FUNCTION tetools.tns_func_attr_value_valdn (p_proto_tns_id IN INTEGER, p_tns_attr IN VARCHAR2 ) RETURN tetools.tns_type_attr_valdn IS
  v_proto_tns_id INTEGER;
  v_tns_match    VARCHAR2(13);
BEGIN
SELECT x.ID,
          CASE
            WHEN x.matching = 0 THEN 'NOT VALIDATED'
            WHEN x.matching > 0 THEN 'VALIDATED'
            ELSE 'ERROR'
          END INTO v_proto_tns_id, v_tns_match FROM (
SELECT a.PROTO_TNS_ID id,
       COUNT(b.tns_count) matching
     FROM (SELECT atpe.PROTO_TNS_ID, count(atpe.tns_attr) tns_count
             FROM tetools.admin_tnsnames_checks        atc
             JOIN tetools.admin_tnsnames_proto_entries atpe
                  ON atc.tns_attr = atpe.tns_attr
            WHERE atpe.PROTO_TNS_ID = p_proto_tns_id
              AND atpe.tns_attr = p_tns_attr
            GROUP BY PROTO_TNS_ID) a,
          (SELECT atpe.PROTO_TNS_ID, count(atpe.tns_attr) tns_count
             FROM tetools.admin_tnsnames_checks        atc
             JOIN tetools.admin_tnsnames_proto_entries atpe
               ON atc.tns_attr = atpe.tns_attr
            WHERE atc.tns_attr = p_tns_attr
              AND atc.tns_attr_check = 'VALUE'
              AND REGEXP_LIKE(TNS_ATTR_VALUE, atc.tns_attr_statement, 'i')
              AND atpe.PROTO_TNS_ID = p_proto_tns_id
            GROUP BY PROTO_TNS_ID) b
            WHERE a.PROTO_TNS_ID = b.PROTO_TNS_ID(+)
            group by a.PROTO_TNS_ID) x;
   RETURN
     tetools.tns_type_attr_valdn(v_proto_tns_id, v_tns_match);
END;
/

CREATE OR REPLACE FUNCTION tetools.tns_func_attr_valdn (p_proto_tns_id IN INTEGER, p_tns_attr IN VARCHAR2 ) RETURN tetools.tns_type_attr_valdn IS
  v_proto_tns_id INTEGER;
  v_tns_match    VARCHAR2(13);
BEGIN
SELECT x.ID,
          CASE
            WHEN x.matching = 0 THEN 'NOT VALIDATED'
            WHEN x.matching > 0 THEN 'VALIDATED'
            ELSE 'ERROR'
          END INTO v_proto_tns_id, v_tns_match FROM (
SELECT a.PROTO_TNS_ID id,
       COUNT(b.tns_count) matching
     FROM (SELECT atpe.PROTO_TNS_ID, count(atpe.tns_attr) tns_count
             FROM tetools.admin_tnsnames_checks        atc
             JOIN tetools.admin_tnsnames_proto_entries atpe
                  ON atc.tns_attr = atpe.tns_attr
            WHERE atpe.PROTO_TNS_ID = p_proto_tns_id
              AND atpe.tns_attr = p_tns_attr
            GROUP BY PROTO_TNS_ID) a,
          (SELECT atpe.PROTO_TNS_ID, count(atpe.tns_attr) tns_count
             FROM tetools.admin_tnsnames_checks        atc
             JOIN tetools.admin_tnsnames_proto_entries atpe
               ON atc.tns_attr = atpe.tns_attr
            WHERE atc.tns_attr = p_tns_attr
              AND atc.tns_attr_check = 'ATTRIBUTE'
              AND REGEXP_LIKE(TNS_ATTR_VALUE, atc.tns_attr_statement, 'i')
              AND atpe.PROTO_TNS_ID = p_proto_tns_id
            GROUP BY PROTO_TNS_ID) b
            WHERE a.PROTO_TNS_ID = b.PROTO_TNS_ID(+)
            group by a.PROTO_TNS_ID) x;
   RETURN
     tetools.tns_type_attr_valdn(v_proto_tns_id, v_tns_match);
END;
/

SELECT tetools.tns_func_attr_value_valdn ( 2110, 'ADDRESS') result FROM DUAL;
SELECT tetools.tns_func_attr_valdn ( 2110, 'ADDRESS') result FROM DUAL;

CREATE OR REPLACE FUNCTION tetools.tns_macro_attr_value_valdn( proto_tns_id IN integer, attr_check IN VARCHAR2 )
RETURN CLOB sql_macro AS
stmt CLOB;
BEGIN
stmt := '
   SELECT x.c.admin_tnsnames_tns_id tns_id, x.c.admin_tnsnames_tns_match match
   FROM (SELECT tetools.tns_func_attr_value_valdn ( tns_macro_attr_value_valdn.proto_tns_id, tns_macro_attr_value_valdn.attr_check ) c FROM DUAL) x
';
  
 RETURN stmt;
END tns_macro_attr_value_valdn;
/

CREATE OR REPLACE FUNCTION tetools.tns_macro_attr_valdn( proto_tns_id IN integer, attr_check IN VARCHAR2 )
RETURN CLOB sql_macro AS
stmt CLOB;
BEGIN
stmt := '
   SELECT x.c.admin_tnsnames_tns_id tns_id, x.c.admin_tnsnames_tns_match match
   FROM (SELECT tetools.tns_func_attr_valdn ( tns_macro_attr_valdn.proto_tns_id, tns_macro_attr_valdn.attr_check ) c FROM DUAL) x
';
  
 RETURN stmt;
END tns_macro_attr_valdn;
/

SELECT tns_id, match FROM tetools.tns_macro_attr_value_valdn(2110, 'ADDRESS');
SELECT tns_id, match FROM tetools.tns_macro_attr_valdn(2110, 'ADDRESS');




SELECT PROTO_TNS_ID, TNS_ATTR, TNS_ATTR_VALUE,
       CASE
         WHEN regexp_like(TNS_ATTR, '^\s*[(]?\w+([_]?[1-9]{1})(\s)?(=)?([[:space:])]+)?([)]?)*$', 'i') THEN '1_'||regexp_substr(TNS_ATTR, '^\s*[(]?\w+*')
         WHEN regexp_like(TNS_ATTR, '^\s*[(]?\w+([_]?[1-9]{1})(\s)?(=)?([[:space:])]+)?([)]?)*$', 'i') THEN '2_'||regexp_substr(TNS_ATTR, '^\s*[(]?\w+([_]?[1-9]{1})*')
         ELSE '3_'||regexp_substr(TNS_ATTR, '^\s*[(]?\w+([_]?[1-9]{1})(\s)?=([[:space:])]+)?([)]?)*$')
       END REGEX
  FROM TETOOLS.ADMIN_TNSNAMES_PROTO_ENTRIES
 WHERE PROTO_TNS_ID IN (2110, 2111)
   AND TNS_ATTR IN ('VALID_DATE_FROM', 'ADDRESS_1')
 ORDER BY 1;
 
 
-- 2025-02-10


create or replace type tetools.type_test 
as object
( type_object_name   VARCHAR2(64),
  type_object_status VARCHAR2(64)
);
/




CREATE OR REPLACE FUNCTION tetools.func_test (p_value IN VARCHAR2, p_stmnt IN VARCHAR2 ) RETURN tetools.type_test IS
  func_object_name   VARCHAR2(64);
  func_object_status VARCHAR2(64);
BEGIN
  SELECT  attr,
          CASE
            WHEN x.matching = 0 THEN 'NOT VALIDATED'
            WHEN x.matching > 0 THEN 'VALIDATED'
            ELSE 'ERROR'
          END INTO func_object_name, func_object_status
     FROM (
           SELECT attr, COUNT(*) matching FROM (
             SELECT p_value as attr, 1
               FROM DUAL
              WHERE REGEXP_LIKE(p_value, p_stmnt, 'i'))) x;
     RETURN tetools.type_test(func_object_name, func_object_status);
END;
/

SELECT x.c.admin_tnsnames_tns_id tns_id, x.c.admin_tnsnames_tns_match match
   FROM (SELECT tetools.tns_func_attr_value_valdn ( tns_macro_attr_value_valdn.proto_tns_id, tns_macro_attr_value_valdn.attr_check ) c FROM DUAL) x


SELECT x.c.TYPE_OBJECT_NAME, x.c.TYPE_OBJECT_STATUS from (select tetools.func_test ('blaat', '^\w') c from dual) x;

SELECT atpe.PROTO_TNS_ID, atpe.PROTO_TNS_ENTRY_LINE, atc.tns_attr, tetools.func_test(atpe.PROTO_TNS_ENTRY_LINE, atc.TNS_ATTR_STATEMENT) regex, atc.TNS_ATTR_STATEMENT
  FROM TETOOLS.TEMP_ADMIN_TNSNAMES_PROTO_ENTRIES atpe
  JOIN TETOOLS.ADMIN_TNSNAMES_CHECKS        atc
       ON atpe.TNS_ATTR = atc.TNS_ATTR
 WHERE atpe.PROTO_TNS_ID = 2408
   --AND atpe.TNS_ATTR IN ('DATE_VALID_FROM', 'ADDRESS_1')
 ORDER BY 1;





  SELECT proto_tns_id
      ,  proto_tns_order_line
      ,  proto_tns_entry_line
      ,  CASE
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_STATUS  = 'VALIDATED'                                                      THEN 'ENTRY_DESCRIPTION'
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$').TYPE_OBJECT_STATUS  = 'VALIDATED' AND proto_tns_order_line <= 2    THEN 'NET_SERVICE_NAME'
           ELSE 'UNMATCHED_ATTRIBUTE'
         END attribute_name
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe
    JOIN ADMIN_TNSNAMES_CHECKS        atc ON atc.tns_attr =func_test( ttpe.proto_tns_entry_line, '^([[:space:](]*)\w[[:space:]]?=?[[:space:]]?').TYPE_OBJECT_NAME
   WHERE ttpe.proto_tns_id = 2408;




WITH cte1 AS (
  SELECT proto_tns_id
      ,  proto_tns_order_line
      ,  proto_tns_entry_line
   FROM TEMP_TNSNAMES_PROTO_ENTRIES WHERE proto_tns_id = 2408
)
SELECT x.c.TYPE_OBJECT_NAME, x.c.TYPE_OBJECT_STATUS from (select tetools.func_test (proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_NAME from dual) x




(SELECT x.c.TYPE_OBJECT_NAME, x.c.TYPE_OBJECT_STATUS from (select tetools.func_test (p_value, p_statement) c from dual) x) T1



  SELECT proto_tns_id
      ,  proto_tns_order_line
      ,  proto_tns_entry_line
      --,  atc.tns_attr
      ,  regexp_replace(ttpe.proto_tns_entry_line, '[()0-9= ]', '') "MODIFIED_STRING"
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe
    JOIN ADMIN_TNSNAMES_CHECKS        atc ON atc.tns_attr = regexp_replace(ttpe.proto_tns_entry_line, '[()0-9= ]', '')
   WHERE ttpe.proto_tns_id = 2408;



select regexp_substr( ttpe.proto_tns_entry_line, '^([[:space:](]*)\w[[:space:]]?=?[[:space:]]?') from TEMP_TNSNAMES_PROTO_ENTRIES ttpe;
select regexp_substr( ' ( blaat = 5', '^([[:space:](]*)\w+[[:space:]]?=?[[:space:]]?') from dual;

select regexp_substr( regexp_substr( ' ( blaat = 5', '^([[:space:](]*)\w+'), '^([[:space:](]*)', 2) from dual;

SELECT regexp_replace(regexp_substr( ' ( blaat = 5', '^([[:space:](]*)\w+'), '[( ]', '') "MODIFIED_STRING" from dual;

SELECT regexp_replace(regexp_substr(ttpe.proto_tns_entry_line, '^([[:space:](]*)\w+'), '[(_0-9 ]', '') "MODIFIED_STRING" from TEMP_TNSNAMES_PROTO_ENTRIES ttpe;



  SELECT proto_tns_id
      ,  proto_tns_order_line
      ,  proto_tns_entry_line
      ,  CASE
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_STATUS  = 'VALIDATED'                                                      THEN 'ENTRY_DESCRIPTION'
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$').TYPE_OBJECT_STATUS  = 'VALIDATED' AND proto_tns_order_line <= 2    THEN 'NET_SERVICE_NAME'
           ELSE 'UNMATCHED_ATTRIBUTE'
         END attribute_name
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe
    JOIN ADMIN_TNSNAMES_CHECKS        atc ON atc.tns_attr = regexp_replace(regexp_substr(ttpe.proto_tns_entry_line, '^([[:space:](]*)\w+'), '[(_0-9 ]', '')



  SELECT proto_tns_id
      ,  proto_tns_order_line
      ,  proto_tns_entry_line
      ,  CASE
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_STATUS  = 'VALIDATED'                                                      THEN 'ENTRY_DESCRIPTION'
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$').TYPE_OBJECT_STATUS  = 'VALIDATED' AND proto_tns_order_line <= 2    THEN 'NET_SERVICE_NAME'
           ELSE regexp_replace(regexp_substr(ttpe.proto_tns_entry_line, '^([[:space:](]*)\w+'), '[(_0-9 ]', '')
         END attribute_name
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe






SELECT proto_tns_entry_line
     , regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+') AS "TRIM"
  FROM TEMP_TNSNAMES_PROTO_ENTRIES;



  SELECT DISTINCT(
         CASE
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_STATUS  = 'VALIDATED'                                                      THEN 'ENTRY_DESCRIPTION'
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$').TYPE_OBJECT_STATUS  = 'VALIDATED' AND proto_tns_order_line <= 2    THEN 'NET_SERVICE_NAME'
           WHEN regexp_like(regexp_replace(LTRIM(regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+'), '(' ), '[_]{1}[1-9]{1}$', ''))   THEN regexp_replace(LTRIM(regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+'), '(' ), '[_]{1}[1-9]{1}$', '')
           ELSE 'UNMATCHED'
         END) attribute_name
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe
   WHERE attribute_name IS NOT NULL;
    



SELECT regexp_replace(
                      regexp_substr(ttpe.proto_tns_entry_line, '^([[:space:](]*)\w+')
                      , '[(_0-9 ]', '')
  FROM TEMP_TNSNAMES_PROTO_ENTRIES;


SELECT DISTINCT(regexp_replace(LTRIM(regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+'), '(' ), '[_]{1}[1-9]{1}$', ''))
  FROM TEMP_TNSNAMES_PROTO_ENTRIES;




## 20250211 #########################################
WITH cte AS (
  SELECT proto_tns_order_line AS "ORDER_ID"
       , CASE
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?#{1}.*').TYPE_OBJECT_STATUS  = 'VALIDATED'                                                      THEN 'ENTRY_DESCRIPTION'
           WHEN func_test(proto_tns_entry_line, '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$').TYPE_OBJECT_STATUS  = 'VALIDATED' AND proto_tns_order_line <= 2    THEN 'NET_SERVICE_NAME'
           WHEN regexp_replace(LTRIM(regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+'), '(' ), '[_]{1}[1-9]{1}$', '') IS NOT NULL    THEN regexp_replace(LTRIM(regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line), '^([[:space:](]*)\w+'), '(' ), '[_]{1}[1-9]{1}$', '')
           ELSE 'UNMATCHED_ATTRIBUTE'
         END attribute_name
       , proto_tns_entry_line
    FROM TEMP_TNSNAMES_PROTO_ENTRIES ttpe
)
SELECT order_id, attribute_name, proto_tns_entry_line
  FROM cte
 WHERE attribute_name <> 'UNMATCHED_ATTRIBUTE' 
ORDER BY order_id ASC;


SELECT TNS_ATTR, TNS_ATTR_STATEMENT
  FROM ADMIN_TNSNAMES_CHECKS
 WHERE TNS_ATTR_CHECK = 'ATTRIBUTE'




SELECT TNS_ATTR, TNS_ATTR_STATEMENT
  FROM tetools.admin_tnsnames_proto_checks
 WHERE  func_test(proto_tns_entry_line, TNS_ATTR_STATEMENT).type_object_status = 'NOT VALIDATED'
ORDER BY order_id;

