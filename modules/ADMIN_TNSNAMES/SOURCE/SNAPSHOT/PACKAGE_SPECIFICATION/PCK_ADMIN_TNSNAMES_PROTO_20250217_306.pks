  --HV-       !!          .#@@@%**%@+                                                                                          !!
  --HV-       !!       :%@@=.  =.   .=    TET - TNSNAMES ADMINISTRATION PACKAGE 0.301                                          !!
  --HV-       !!     :@@%: .=#%@@@=  .                                                                                         !!
  --HV-       !!    #@@= =@@@@%@@%=.                                                                                           !!
  --HV-       !!  .@@@::@@@=  =:          TNS Registration       : test_alias07 (22-AUG-24 02:05:09 PM)                        !!
  --HV-       !!  *@@%.@@# :.:::.:= -     USER                   : TETOOLS                                                     !!
  --HV-       !!  @@@#=@@: +:-*#**:#:                                                                                          !!
  --HV-       !!  *@@@=%@                                                                                                      !!
  --HV-       !!   =@@@@@@@@#:                                                                                                 !!
  --HV-       !!                                                                                                               !!
  --HV-       !!---------------------------------------------------------------------------------------------------------------!!
