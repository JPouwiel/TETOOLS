SELECT regexp_substr('           (PROTOCOL_1 = TCP)'                     , '^\s*[(]?\w+(\d{1})?(\s)?=[[:space:]]?(tcp|tcps|ws)([)])?(\s)*$') regex__no_trail_space
     , regexp_substr('           (PROTOCOL_1 = TCP)                     ', '^\s*[(]?\w+(\d{1})?(\s)?=[[:space:]]?(tcp|tcps|ws)([)])?(\s)*$') regex_yes_trail_space
     , regexp_substr('           (PROTOCOL_1 = TCP)                     ', '^\s*[(]?\w+(\d{1})?(\s)?=[[:space:]]?(TCP|TCPS|WS)([)])?(\s)*$') regex_yes_trail_space
  FROM dual;
  
  



SELECT proto_tns_id
    ,  proto_tns_order_line order_id
    , '*'||TRIM(BOTH ' ' FROM proto_tns_entry_line )||'*' AS "TRIMMED_ENTRY_LINE"
    , regexp_replace(proto_tns_entry_line, '[,?<>!@$%^&~`+]', '', 1, 0, 'i') AS "CLEANED"
    ,  CASE
         -- ENTRY DESCRIPTION 
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:])]*)?#{1}.*','i')                                                                                                               THEN REGEXP_REPLACE(REGEXP_REPLACE(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^[[:space:]]*','',1,1,'i'), '[[:space:]]*$','',1,1,'i')
         -- DESCRIPTION  / DESCRIPTION_LIST 
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:])]*)?\w+(\s)?=([[:space:])]+)?$','i') AND proto_tns_order_line <= 2                                                             THEN REGEXP_REPLACE(REGEXP_REPLACE(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^[[:space:]]*','',1,1,'i'), '[[:space:]]*=[[:space:]]*$','',1,1,'i')
         -- DATE_VALID_FROM / DATE_VALID_TILL
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^\s*[(]?\w+(\d{1})?(\s)?=[[:space:]]?(sysdate|(9999|20[0-9]{2})-(1[0-2]|0[0-9])-(0[1-9]|[1-2][0-9]|3[0-1]))([)])?*$','i')                   THEN regexp_substr(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '(sysdate|(9999|20[0-9]{2})-(1[0-2]|0[0-9])-(0[1-9]|[1-2][0-9]|3[0-1]))')
         -- NON-LEAF MEMBERS
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^\s*[(]?\w+(\s)?=([[:space:])]+)?([)]?)*$','i')                                                                                             THEN 'NULL' --REGEXP_REPLACE(proto_tns_entry_line, '\s*[(]?\w+(\s)?=([[:space:])]+)?', '', 1)
         -- ATRRIBUTES WITH DIGIT VALUES, e.g.: PORT/RETRY_DELAY/
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^\s*[(]?\w+(\s)?=[[:space:]]?(\d+[[:space:]]?(ms|msec|sec|min)?|ON|OFF|TRUE|FALSE|tcp|tcps|ws|shared|dedicated)([)])?([[:space:]]?)*$','i') THEN regexp_replace(regexp_replace(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:]]+)?([(])?\w+([[:space:]])+=([[:space:]])+','',1,1,'i'),'([[:space:]]+)?([)])?*$','',1,1,'i')
         -- HOSTNAME / IP-ADDRESS / PHASE / TARGET_ENV 
         WHEN regexp_like(proto_tns_entry_line, '^\s*[(]?\w+(\d{1})?(\s)*=(\s)*((\w+([.-]*\w+)*)*|([1-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.(([0-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){2}([1-9]{1}|[0-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))?(\s)*([)])?(\s)*$','i')
              THEN regexp_replace(regexp_replace(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:]]+)?([(])?\w+([[:space:]])+=([[:space:]])+','',1,1,'i'),'([[:space:]]+)?([)])?*$','',1,1,'i')
         -- CLOSING_BRACKET
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:])]*)[)]{1}$','i')                                                                                                                THEN 'NULL'
         -- OPENING_BRACKET
         WHEN regexp_like(TRIM(BOTH ' ' FROM proto_tns_entry_line ), '^([[:space:])]*)[(]{1}$','i')                                                                                                                THEN 'NULL'
         WHEN regexp_like(proto_tns_entry_line, '^\s*[(]?\w+(\d{1})?(\s)?=[[:space:]]?.*(sysdate|(9999|20[0-9]{2})-(1[0-2]|0[0-9])-(0[1-9]|[1-2][0-9]|3[0-1])).*([)])?.*$','i') THEN
         --    REGEXP_REPLACE(REGEXP_REPLACE(proto_tns_entry_line, '^\s*[(]?', '',1),'(\s)?=(\s)?.*(sysdate|(9999|20[0-9]{2})-(1[0-2]|0[0-9])-(0[1-9]|[1-2][0-9]|3[0-1])).*([)]?).*$','',1,1,'i')
         --REGEXP_REPLACE(proto_tns_entry_line, '^\s*[(]?', '',1)
         REGEXP_REPLACE(REGEXP_SUBSTR(proto_tns_entry_line, '[^=]+$'), '[[:space:]),]', '')
         ELSE 'UNMATCHED_VALUE'
       END trimmed_attribute_value
  FROM TEMP_TNSNAMES_PROTO_ENTRIES WHERE proto_tns_id = 2408
 ORDER BY proto_tns_order_line;


