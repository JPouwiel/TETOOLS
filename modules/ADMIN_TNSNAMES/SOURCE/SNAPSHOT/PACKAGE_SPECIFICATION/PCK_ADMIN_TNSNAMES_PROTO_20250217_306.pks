  --HV-       !!                                                                                                               !!
  --HV-       !!   PHASE                     : T                                                                               !!
  --HV-       !!   TARGET ENVIRONMENTS       : DTA                                                                             !!
  --HV-       !!   CREATED TNS_ID            : 441                                                                             !!
  --HV-       !!   ----------------------------------------------------                                                        !!
  --HV-       !!                                                                                                               !!
  --HV-       !!   # [test_alias07 - 2024-08-22] :: TEST description                                                           !!
  --HV-       !!   test_alias07 =                                                                                              !!
  --HV-       !!     (DESCRIPTION =                                                                                            !!
  --HV-       !!     (ADDRESS = TCP)                                                                                           !!
  --HV-       !!       (HOST = example.invalid)                                                                     !!
  --HV-       !!       (PORT = 1521)                                                                                           !!
  --HV-       !!       )                                                                                                       !!
  --HV-       !!       (CONNECT_DATA =                                                                                         !!
  --HV-       !!         (SERVER = DEDICATED)                                                                                  !!
  --HV-       !!         (SERVICE_NAME = service01)                                                                            !!
  --HV-       !!       )                                                                                                       !!
  --HV-       !!     )                                                                                                         !!
  --HV-       !!                                                                                                               !!
  --HV-       !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  --HV-                                                             Don't forget to execute TETOOLS.ADMIN_TNSNAMES.GENERATE_TNS !
  --HV-
  --HV-
  --HS-  /* ======================================================================================================= */
  --
  --
  -- TYPES
  --
  TYPE admin_tnsnames_attr_proto_type
  IS RECORD
  ( tns_attr_name   VARCHAR2(64),
    tns_attr_status VARCHAR2(64)
  );
  --
  TYPE admin_tnsnames_attr_proto_table
  IS TABLE OF
  admin_tnsnames_attr_proto_type;
  --
  --
  -- FUNCTIONS
  --
  FUNCTION admin_tnsnames_attr_proto_vald (p_value            IN VARCHAR2,
                                           p_stmnt            IN VARCHAR2 )                          RETURN admin_tnsnames_attr_proto_table;
  --FUNCTION            attr_proto_vald ( p_value               IN VARCHAR2,
  --                                      p_stmnt               IN VARCHAR2 )                          RETURN tetools.admin_tnsnames_proto.admin_tnsnames_attr_proto_table;
  --
  --
  --  PROCEDURES
  --
  PROCEDURE report_proto_registration ( json_string          IN CLOB,
                                        p_tns_id             IN INTEGER,
                                        p_type               IN VARCHAR2 DEFAULT 'ALL'
                                      );
  --
  PROCEDURE            evaluate_entry ( p_proto_tns_id       IN INTEGER
                                      );
  --
  PROCEDURE              intake_entry ( p_proto_entry         IN CLOB
                                      );
  --
END admin_tnsnames_proto;
/
