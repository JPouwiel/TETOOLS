SELECT regexp_substr(TNS_ATTR_STATEMENT, '^\s*[(]?\w+(\d{1})?(\s)*=(\s)*((\w+([.-]*\w+)*)*|([1-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.(([0-9]{1}|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){2}([1-9]{1}|[0-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))?(\s)*([)])?(\s)?$') regex
     , CASE
         WHEN regexp_like() THEN regexp_substr(TNS_ATTR_STATEMENT, TNS_ATTR_STATEMENT)
         ELSE 
       END case_stmnt
  FROM admin_tnsnames_checks
 WHERE tns_attr IN ('TARGET_ENV', 'PHASE', 'SERVER', 'RETRY_COUNT', 'SERVICE_NAME', 'HOST')






SELECT order_id, tns_attr, '*'||proto_tns_entry_line||'*' proto_tns_entry_line
     , regexp_substr(proto_tns_entry_line, TNS_ATTR_STATEMENT) sub_stmnt
     , CASE
         WHEN regexp_like(proto_tns_entry_line, TNS_ATTR_STATEMENT, 'i') THEN '____VALID__'||regexp_substr(proto_tns_entry_line, TNS_ATTR_STATEMENT)
         ELSE 'NOT_VALID__'||regexp_substr(proto_tns_entry_line, TNS_ATTR_STATEMENT)
       END case_stmnt
  FROM tetools.admin_tnsnames_proto_checks
 --WHERE NOT regexp_like(proto_tns_entry_line, TNS_ATTR_STATEMENT, 'i')
ORDER BY order_id;


--   ORDER_ID TNS_ATTR                   PROTO_TNS_ENTRY_LINE                                 SUB_STMNT                                          CASE_STMNT
-- ---------- -------------------------- ---------------------------------------------------- -------------------------------------------------- ----------------------------------------------------------------
--          1 ENTRY_DESCRIPTION          * # test description for parsing existing tns entry*  # test description for parsing existing tns entry ____VALID__ # test description for parsing existing tns entry
--          3 DESCRIPTION_LIST           *   (DESCRIPTION_LIST =                            *    (DESCRIPTION_LIST =                             ____VALID__   (DESCRIPTION_LIST =
--          4 DESCRIPTION                *     (DESCRIPTION =                               *      (DESCRIPTION =                                ____VALID__     (DESCRIPTION =
--          5 TRANSPORT_CONNECT_TIMEOUT  *     (TRANSPORT_CONNECT_TIMEOUT = 5)              *      (TRANSPORT_CONNECT_TIMEOUT = 5)               ____VALID__     (TRANSPORT_CONNECT_TIMEOUT = 5)
--          6 CONNECT_TIMEOUT            *     (CONNECT_TIMEOUT = 5)                        *      (CONNECT_TIMEOUT = 5)                         ____VALID__     (CONNECT_TIMEOUT = 5)
--          7 RETRY_DELAY                *     (RETRY_DELAY = 1)                            *      (RETRY_DELAY = 1)                             ____VALID__     (RETRY_DELAY = 1)
--          8 RETRY_COUNT                *     (RETRY_COUNT = BLAAT)*                              (RETRY_COUNT = BLAAT)                         ____VALID__     (RETRY_COUNT = BLAAT)
--          9 FAILOVER                   *     (FAILOVER = ON)                              *      (FAILOVER = ON)                               ____VALID__     (FAILOVER = ON)
--         10 LOAD_BALANCE               *     (LOAD_BALANCE = OFF)                         *      (LOAD_BALANCE = OFF)                          ____VALID__     (LOAD_BALANCE = OFF)
