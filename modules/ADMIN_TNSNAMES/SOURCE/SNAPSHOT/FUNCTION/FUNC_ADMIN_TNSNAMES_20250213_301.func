              THEN regexp_replace(regexp_replace(proto_tns_entry_line, '^([[:space:]]+)?([(])?\w+([[:space:]])+=([[:space:]])+','',1,1,'i'),'([[:space:]]+)?([)])?*$','',1,1,'i')
